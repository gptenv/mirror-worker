# Optional inbound API keys for programmatic access.
MIRROR_API_KEY=
MIRROR_API_KEYS=
OPENAI_API_KEY=

# Host port for Docker Compose.
MIRROR_PORT=8799

# Optional fixed 32-byte key (base64 or 64 hex chars) for local Docker storage.
# Worker deployments require a separately configured MIRROR_STORE_KEY secret.
MIRROR_STORE_KEY=
